#
# ATRIUM -- Atrium platform kernel for arm64 (development build).
#
# GENERIC plus the Laminar scheduler, the boot splash, and the attack-surface
# reduction in sys/conf/std.atrium (see the rationale there).  Debugging
# (INVARIANTS, WITNESS) stays on, as in GENERIC on -CURRENT; ATRIUM-NODEBUG is
# the shipping variant and ATRIUM-KASAN the sanitizer variant for kmod tests.
#
# Phase H (DVFS) is compiled in but disabled at boot (kern.sched.phaseh_enable=0);
# enable per-platform after validating the local cpufreq(4) backend.
#
# For developer / instrumented kernels see LAMINAR-DEV (adds
# cpufreq_mock for synthetic DVFS testing on platforms without a real
# cpufreq driver, e.g. QEMU TCG/HVF).
#
include GENERIC
ident   ATRIUM
options SCHED_LAMINAR

# Atrium boot splash: vt(4)'s DEV_SPLASH framework draws a loader-preloaded
# RGBA PNG (loader `splash="..."`) and suppresses video console text until a
# keypress. Patched in vt_core.c so a preloaded image enables it WITHOUT
# RB_MUTE, keeping the serial console verbose for debugging.
# `device splash` (NOT `options DEV_SPLASH`): config(8)'s DEV_<dev> convention
# both defines the DEV_SPLASH macro AND makes `splash` true in conf/files, so
# vt_cpulogos.c + the logo images (vt_logo_*, vtterm_draw_cpu_logos) link in.
device splash

include "std.atrium"

# arm64 targets are QEMU virt (virtio) and Apple silicon.  Drop the
# hypervisor guests and server NICs we never run on.  mlx5 and Hyper-V also
# pull in COMPAT_LINUXKPI, which Atrium policy excludes.
nodevice	hyperv
nodevice	mlx5
nodevice	mlx5en
nodevice	mlxfw
nooptions	COMPAT_LINUXKPI
nooptions	RATELIMIT
nodevice	vmx
nodevice	pvscsi
nodevice	em
nodevice	ix
nooptions	IEEE80211_SUPPORT_MESH
